:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5a5ef6eaa6d0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x5a5ef6eaa860 .scope module, "jump_tb" "jump_tb" 3 2;
 .timescale -9 -12;
v0x5a5ef6ee83c0_0 .var "enable", 0 0;
v0x5a5ef6ee8480_0 .var "fallback", 31 0;
v0x5a5ef6ee8520_0 .var "index", 25 0;
v0x5a5ef6ee85c0_0 .var "pc4", 31 0;
v0x5a5ef6ee8690_0 .net "target", 31 0, v0x5a5ef6ee8080_0;  1 drivers
S_0x5a5ef6eae060 .scope module, "dut" "jump" 3 6, 4 2 0, S_0x5a5ef6eaa860;
 .timescale -9 -12;
    .port_info 0 /INPUT 32 "not_jump";
    .port_info 1 /INPUT 32 "pc_plus_4";
    .port_info 2 /INPUT 1 "jump";
    .port_info 3 /INPUT 26 "is_jump";
    .port_info 4 /OUTPUT 32 "next_pc";
v0x5a5ef6ebd470_0 .net *"_ivl_1", 3 0, L_0x5a5ef6ee8780;  1 drivers
L_0x7c3ee8157018 .functor BUFT 1, C4<00>, C4<0>, C4<0>, C4<0>;
v0x5a5ef6ebd720_0 .net/2u *"_ivl_2", 1 0, L_0x7c3ee8157018;  1 drivers
v0x5a5ef6ee7dd0_0 .net "is_jump", 25 0, v0x5a5ef6ee8520_0;  1 drivers
v0x5a5ef6ee7e90_0 .net "jump", 0 0, v0x5a5ef6ee83c0_0;  1 drivers
v0x5a5ef6ee7f50_0 .net "jump_target", 31 0, L_0x5a5ef6ee88a0;  1 drivers
v0x5a5ef6ee8080_0 .var "next_pc", 31 0;
v0x5a5ef6ee8160_0 .net "not_jump", 31 0, v0x5a5ef6ee8480_0;  1 drivers
v0x5a5ef6ee8240_0 .net "pc_plus_4", 31 0, v0x5a5ef6ee85c0_0;  1 drivers
E_0x5a5ef6e6eb30 .event anyedge, v0x5a5ef6ee7e90_0, v0x5a5ef6ee7f50_0, v0x5a5ef6ee8160_0;
L_0x5a5ef6ee8780 .part v0x5a5ef6ee85c0_0, 28, 4;
L_0x5a5ef6ee88a0 .concat [ 2 26 4 0], L_0x7c3ee8157018, v0x5a5ef6ee8520_0, L_0x5a5ef6ee8780;
    .scope S_0x5a5ef6eae060;
T_0 ;
Ewait_0 .event/or E_0x5a5ef6e6eb30, E_0x0;
    %wait Ewait_0;
    %load/vec4 v0x5a5ef6ee7e90_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %load/vec4 v0x5a5ef6ee7f50_0;
    %store/vec4 v0x5a5ef6ee8080_0, 0, 32;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0x5a5ef6ee8160_0;
    %store/vec4 v0x5a5ef6ee8080_0, 0, 32;
T_0.1 ;
    %jmp T_0;
    .thread T_0, $push;
    .scope S_0x5a5ef6eaa860;
T_1 ;
    %pushi/vec4 3735928559, 0, 32;
    %store/vec4 v0x5a5ef6ee8480_0, 0, 32;
    %pushi/vec4 268435456, 0, 32;
    %store/vec4 v0x5a5ef6ee85c0_0, 0, 32;
    %pushi/vec4 3, 0, 26;
    %store/vec4 v0x5a5ef6ee8520_0, 0, 26;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5a5ef6ee83c0_0, 0, 1;
    %delay 1000, 0;
    %load/vec4 v0x5a5ef6ee8690_0;
    %cmpi/ne 268435468, 0, 32;
    %jmp/0xz  T_1.0, 6;
    %vpi_call/w 3 9 "$fatal", 32'sb00000000000000000000000000000001, "Jump high bits incorrect" {0 0 0};
T_1.0 ;
    %pushi/vec4 4026531840, 0, 32;
    %store/vec4 v0x5a5ef6ee85c0_0, 0, 32;
    %pushi/vec4 67108863, 0, 26;
    %store/vec4 v0x5a5ef6ee8520_0, 0, 26;
    %delay 1000, 0;
    %load/vec4 v0x5a5ef6ee8690_0;
    %cmpi/ne 4294967292, 0, 32;
    %jmp/0xz  T_1.2, 6;
    %vpi_call/w 3 11 "$fatal", 32'sb00000000000000000000000000000001, "Jump index incorrect" {0 0 0};
T_1.2 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5a5ef6ee83c0_0, 0, 1;
    %delay 1000, 0;
    %load/vec4 v0x5a5ef6ee8690_0;
    %load/vec4 v0x5a5ef6ee8480_0;
    %cmp/ne;
    %jmp/0xz  T_1.4, 6;
    %vpi_call/w 3 13 "$fatal", 32'sb00000000000000000000000000000001, "Jump disabled selection incorrect" {0 0 0};
T_1.4 ;
    %vpi_call/w 3 14 "$display", "PASS jump unit: PC+4 upper bits, index shift, disabled mux" {0 0 0};
    %vpi_call/w 3 14 "$finish" {0 0 0};
    %end;
    .thread T_1;
